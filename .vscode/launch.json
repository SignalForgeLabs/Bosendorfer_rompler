{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Standalone",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/BosendorferImperial_artefacts/Debug/Standalone/Bösendorfer Imperial 290",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: Build All",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
